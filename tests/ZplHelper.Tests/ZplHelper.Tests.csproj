<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(PackedZplHelperVersion)' == ''">
    <ProjectReference Include="../../src/ZplHelper/ZplHelper.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(PackedZplHelperVersion)' != ''">
    <PackageReference Include="ZplHelper" Version="$(PackedZplHelperVersion)" />
  </ItemGroup>
</Project>
