<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ZplHelper</PackageId>
    <Version>0.1.0</Version>
    <Authors>RMP Software and BinaryKits contributors</Authors>
    <Description>Render Zebra ZPL labels locally to PNG with SkiaSharp.</Description>
    <PackageTags>ZPL;Zebra;label;PNG;SkiaSharp</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/rmpsoftware/zplHelper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rmpsoftware/zplHelper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RootNamespace>BinaryKits.Zpl</RootNamespace>
    <SkiaSharpVersion>4.157.0</SkiaSharpVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="$(SkiaSharpVersion)" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.4.0.200" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Viewer/Resources/DejaVuSansMono.ttf" LogicalName="ZplHelper.DejaVuSansMono.ttf" />
    <EmbeddedResource Include="Viewer/Resources/ZplGS.ttf" LogicalName="ZplHelper.ZplGS.ttf" />
    <None Include="../../LICENSE;../../README.md;../../NOTICE.md" Pack="true" PackagePath="/" />
    <None Include="../../licenses/DejaVu.txt" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
</Project>
